# 복사해서 .env.local로 쓰세요. NEXT_PUBLIC_ 값은 빌드 때 브라우저 번들에 들어가요.

# 스튜디오 서버 주소(origin). 끝에 슬래시를 붙이지 않아요.
NEXT_PUBLIC_STUDIO_API_URL=http://127.0.0.1:8100

# 제작자 식별용 Bearer 토큰. 서버의 API_KEYS 중 하나와 같아야 해요.
# 로그인 대신 쓰는 값이라 화면을 여는 사람이 볼 수 있어요. 운영 서버는 개발용 토큰을 거부해요.
NEXT_PUBLIC_STUDIO_API_TOKEN=dev-only-change-me
