# 복사해서 .env.local로 쓰세요. NEXT_PUBLIC_ 값은 빌드 때 브라우저 번들에 들어가요.

# 스튜디오 서버 주소(origin). 끝에 슬래시를 붙이지 않아요.
NEXT_PUBLIC_STUDIO_API_URL=http://127.0.0.1:8100

# 선택. 서버 API_KEYS에 등록한 토큰을 넣으면 그 제작자의 고정 작업함을 써요.
# 비워 두면 브라우저마다 만든 방문자 ID를 보내고, 서버의 익명 모드가 그 브라우저만의 작업함을 만들어요.
# 어느 쪽이든 화면을 여는 사람이 볼 수 있는 값이에요.
NEXT_PUBLIC_STUDIO_API_TOKEN=
